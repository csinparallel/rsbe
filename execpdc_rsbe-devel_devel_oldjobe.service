[Unit]
Description=ExecPDC devel oldjobe service
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
PIDFile=/home/rab/DEVEL_OLDJOBE/execpdc/pid_server
Restart=always
RestartSec=1
User=www-data
Group=www-data
WorkingDirectory=/home/rab/DEVEL_OLDJOBE/execpdc/
ExecStart=/home/rab/DEVEL_OLDJOBE/execpdc/execpdc_server -service
ExecStop=/usr/bin/kill -TERM $MAINPID

[Install]
WantedBy=multi-user.target
